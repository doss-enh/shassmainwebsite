NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only. Create a token with "Editor" (or higher) permissions in
# sanity.io/manage -> API -> Tokens. Required for the admin console and
# for the public enquiry/contact/newsletter API routes to write data.
SANITY_API_WRITE_TOKEN=

# Simple shared-password gate for the admin console (see src/lib/auth.ts).
# Replace with a real auth provider before going to production.
ADMIN_CONSOLE_PASSWORD=
ADMIN_SESSION_SECRET=
