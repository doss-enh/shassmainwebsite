NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only. Create a token with "Editor" (or higher) permissions in
# sanity.io/manage -> API -> Tokens. Used by the import script and by
# Studio-side revalidation; the storefront read client does not need it.
SANITY_API_WRITE_TOKEN=

# Postgres — enquiries, staff users/sessions, form submissions, newsletter
# subscribers, customers, and the audit log (see db/schema.sql). No ORM:
# queries are plain SQL via the `postgres` package (src/lib/db.ts).
#
# Local dev (zero Docker): run `npm run db:dev` in one terminal (starts
# PGlite — Postgres compiled to WASM — behind a real Postgres socket on
# port 5434), then `npm run db:migrate` once to create the tables.
DATABASE_URL=postgres://postgres@127.0.0.1:5434/postgres

# Run `npm run db:seed-admin` once (with ADMIN_EMAIL / ADMIN_PASSWORD set)
# to create the first staff login for /admin.
